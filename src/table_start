.data
        start_success_message:      .asciiz "Atendimento iniciado com sucesso"
        table_not_found_message:   .asciiz "Falha: mesa inexistente"
        table_occupied_message:    .asciiz "Falha: mesa ocupada"
        invalid_command_message:   .asciiz "Comando invalido"

.text
# This function aims to start a service at a specific table.
# It parses the command arguments, validates the table number,
# checks if the table is already occupied, and stores the
# customer's phone and name into the table structure.
#
# The expected command format is:
# mesa_iniciar-table-phone-name
#
# Input:
#       buffer_space: command string previously read from the user
#
# Output:
#       The table is marked as occupied and customer data is stored
#       An error message is printed if the command is invalid

table_start:
        # Opening stack space to preserve return address and temporary values
        # Stack layout:
        #       0($sp):  saved $ra
        #       4($sp):  parsed argument 1 (table)
        #       8($sp):  parsed argument 2 (phone)
        #       12($sp): parsed argument 3 (name)
        #       16($sp): target table address
        addi $sp, $sp, -20
        sw   $ra, 0($sp)

        # Preparing arguments for the parser
        la $a0, buffer_space
        li $a1, 13              # length of "mesa_iniciar"
        li $a2, 3               # expected number of arguments

        # Parsing command string
        jal function_parser

        # If parsing fails, command format is invalid
        bne $v0, $0, invalid_command

        # Loading parsed argument addresses
        lw $t0, parsed_arg1     # table
        lw $t1, parsed_arg2     # phone
        lw $t2, parsed_arg3     # name

        # Saving arguments on stack (protect from function calls)
        sw $t0, 4($sp)
        sw $t1, 8($sp)
        sw $t2, 12($sp)

        # Converting table number from ASCII to integer
        move $a0, $t0
        jal ascii_to_int

        # Check if conversion failed (invalid numeric string)
        li $t5, -1
        beq $v0, $t5, table_not_found

        # Valid table range: 1 to 15
        li $t6, 1
        li $t7, 15

        blt $v0, $t6, table_not_found
        bgt $v0, $t7, table_not_found

        # Saving valid table number
        move $t0, $v0
        sw   $t0, 4($sp)

        # Calculating table address: base + (index * TABLE_SIZE)
        addi $t1, $t0, -1
        li   $t2, TABLE_SIZE
        mul  $t1, $t1, $t2

        la   $t3, tables
        add  $t3, $t3, $t1

        # Saving table address
        move $t4, $t3
        sw   $t4, 16($sp)

        # Checking if table is already occupied
        lw $t5, TABLE_STATUS($t4)
        bne $t5, $0, table_occupied

        # Marking table as occupied
        li $t5, 1
        sw $t5, TABLE_STATUS($t4)

        # Loading phone argument
        lw $t1, 8($sp)

        # Copying phone string into table structure
        addi $a0, $t4, TABLE_PHONE
        move $a1, $t1
        jal strcpy

        # Loading name argument
        lw $t2, 12($sp)

        # Copying name string into table structure
        addi $a0, $t4, TABLE_RESP
        move $a1, $t2
        jal strcpy

        # Printing success message
        la $a0, start_success_message
        jal print_str_mmio

        # Restoring stack and returning
        lw   $ra, 0($sp)
        addi $sp, $sp, 20
        jr   $ra


# -----------------------------
# ERROR HANDLING
# -----------------------------

invalid_command:
        # Printing invalid command message (parser failure)
        la $a0, invalid_command_message
        jal print_str_mmio

        lw   $ra, 0($sp)
        addi $sp, $sp, 20
        jr   $ra


table_not_found:
        # Printing message when table number is invalid
        la $a0, table_not_found_message
        jal print_str_mmio

        lw   $ra, 0($sp)
        addi $sp, $sp, 20
        jr   $ra


table_occupied:
        # Printing message when table is already occupied
        la $a0, table_occupied_message
        jal print_str_mmio

        lw   $ra, 0($sp)
        addi $sp, $sp, 20
        jr   $ra
